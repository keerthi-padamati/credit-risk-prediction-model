# Byte-order-mark safe UTF-8 gitignore for Python / Flask project
# ──────────────────────────────────────────────────
# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/
.env/

# Jupyter
.ipynb_checkpoints/
*.ipynb~

# Model artifacts (optional — uncomment to exclude large binaries)
# model.pkl
# encoders.pkl

# EDA plots (auto-generated)
static/assets/eda/

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# OS
.DS_Store
Thumbs.db
desktop.ini

# Secrets / credentials
*.env
.env
secrets.py

# Logs
*.log


# Virtual Environments
venv/
env/
.env

# Python Cache
__pycache__/
*.py[cod]
*$py.class

# Raw Data (Prevents uploading huge CSV files to GitHub)
data/*.csv

# OS Generated Files
.DS_Store
Thumbs.db

# Machine Learning Artifacts 
# (Note: Remove the '#' on the next two lines if you DO NOT want to upload your models to GitHub)
# model.pkl
# encoders.pkl

# IDE / Editor Files
.vscode/
.idea/
